{
  "name": "@afl-lang/core",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical AFL IR, validator, builder, and reference runtime",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "afl": "./bin/afl.mjs"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "test:ts": "npm run build && node --test test/*.test.mjs",
    "test:python": "python3 -m pytest python/tests",
    "test": "npm run test:ts && npm run test:python"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
