{
  "irVersion": "0.1",
  "name": "cli-echo",
  "entry": "main",
  "flows": {
    "main": {
      "input": { "type": "string" },
      "output": { "type": "string" },
      "body": {
        "kind": "return",
        "id": "return-input",
        "value": { "kind": "ref", "scope": "input" }
      }
    }
  }
}
